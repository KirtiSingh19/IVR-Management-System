# Copy this file to .env and fill in your own values.
#
# .env is git-ignored. This file is committed, so it must never contain a real
# password.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ivr_manager
MYSQL_USER=root
MYSQL_PASSWORD=

# Where the API listens. The frontend defaults to http://127.0.0.1:5000.
API_HOST=127.0.0.1
API_PORT=5000

# The frontend is served from a different port than this API, so the browser
# treats every call as cross-origin and the response has to opt in. Narrow this
# to your real frontend origin (e.g. http://localhost:5500) once it is fixed.
CORS_ORIGIN=*
